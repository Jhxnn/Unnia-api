# Variáveis do Unnia lidas pelo docker compose. Copie este arquivo para .env e ajuste os valores.
# O .env tem segredos e NÃO vai para o git (veja o .gitignore).

# ---- Segurança da API (obrigatórias para subir a API em contêiner)
# Chave que assina os tokens de login: mínimo de 32 caracteres, aleatória e secreta.
UNNIA_JWT_SECRET=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres

# ---- Administrador da plataforma, criado na primeira inicialização
UNNIA_ADMIN_EMAIL=admin@unnia.com
UNNIA_ADMIN_PASSWORD=troque-por-uma-senha-forte

# ---- E-mail (código de confirmação do cadastro)
# Como está, as mensagens vão para o Mailpit do compose e podem ser lidas em http://localhost:8025.
# Para enviar e-mails de verdade, troque pelos dados do seu serviço de SMTP, por exemplo:
#   UNNIA_MAIL_HOST=smtp.gmail.com   UNNIA_MAIL_PORT=587   UNNIA_MAIL_AUTH=true   UNNIA_MAIL_STARTTLS=true
#   UNNIA_MAIL_USER=voce@gmail.com   UNNIA_MAIL_PASSWORD=<senha de app>
#   UNNIA_MAIL_FROM=Unnia <voce@gmail.com>
UNNIA_MAIL_HOST=mailpit
UNNIA_MAIL_PORT=1025
UNNIA_MAIL_USER=
UNNIA_MAIL_PASSWORD=
UNNIA_MAIL_AUTH=false
UNNIA_MAIL_STARTTLS=false
UNNIA_MAIL_FROM=Unnia <nao-responda@unnia.local>
